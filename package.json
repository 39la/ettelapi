{
  "name": "ettelapi",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "validate": "cf build && cf deploy --dry-run",
    "deploy": "cf deploy",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "mock": "node mockups/generate.mjs",
    "lint": "oxlint src test cloudflare.config.ts wrangler.config.ts",
    "fmt": "oxfmt src test cloudflare.config.ts wrangler.config.ts",
    "fmt:check": "oxfmt --check src test cloudflare.config.ts wrangler.config.ts",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test"
  },
  "dependencies": {
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/bun": "latest",
    "cf": "^1.0.0-rc.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
